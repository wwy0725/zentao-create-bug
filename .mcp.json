{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--user-data-dir",
        "${USERPROFILE}\\.claude\\playwright-mcp\\browser-data",
        "--config",
        "${CLAUDE_PROJECT_DIR}\\.claude\\playwright-mcp\\config.json"
      ]
    }
  }
}
